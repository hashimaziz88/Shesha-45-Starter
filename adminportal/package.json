{
  "name": "@shesha-io/starter",
  "version": "0.0.1",
  "private": false,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "export": "next export --webpack",
    "start": "NODE_ENV=production node --max-old-space-size=8192 server.js",
    "build:analyze": "ANALYZE=true npm run build",
    "lint": "eslint **/*.{js,jsx,ts,tsx}",
    "prettier": "prettier --write **/*.{js,jsx,ts,tsx}",
    "test": "jest -c test/jest.config.js",
    "postinstall": "shesha init"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/boxfusion/_packaging/npm.shesha.dev/npm/registry/"
  },
  "overrides": {
    "@rc-component/portal": "2.2.1",
    "@react-awesome-query-builder/antd": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons",
      "rc-picker": "4.11.3"
    },
    "rc-picker": {
      "@rc-component/trigger": "2.3.1"
    },
    "next-navigation-guard": {
      "next": "$next"
    }
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@microsoft/applicationinsights-react-js": "^3.1.2",
    "@microsoft/applicationinsights-web": "^2.6.2",
    "@next/bundle-analyzer": "^14.2.4",
    "@shesha-io/reactjs": "0.46.0",
    "@types/react-dom": "^19.2.4",
    "antd": "^6.6.2",
    "antd-style": "^4.1.0",
    "moment": "^2.30.1",
    "next": "^16.3.1",
    "next-navigation-guard": "^0.2.0",
    "next-nprogress-bar": "^2.3.12",
    "qs": "^6.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "styled-components": "^5.2.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/redux-actions": "^2.3.1",
    "@types/styled-components": "^5.1.9",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/eslint-plugin-tslint": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "dotenv": "^8.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsdoc": "^48.0.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^4.3.7",
    "isomorphic-unfetch": "^3.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^10.5.3",
    "nock": "^13.0.6",
    "prettier": "^3.3.3",
    "redux-actions": "^2.6.5",
    "ts-jest": "^29.1.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run lint -- --quiet --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
